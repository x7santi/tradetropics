# Supabase — get these from your project at supabase.com > Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Finnhub — kept for reference, candle data requires paid plan
VITE_FINNHUB_API_KEY=your-finnhub-key-here

# Twelve Data — free key at twelvedata.com (stocks + forex + crypto candles)
VITE_TWELVEDATA_API_KEY=your-twelvedata-key-here

# Trading Economics — economic calendar API (optional; can also be set in app Settings)
# https://tradingeconomics.com/api/
VITE_TRADING_ECONOMICS_API_KEY=your-tradingeconomics-key-here
